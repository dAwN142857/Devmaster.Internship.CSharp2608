@using NguyenDuyAn_241230651.Models

<header class="header">
    <div class="topbar">
        <div class="container">
            <span>Phòng Hành chính - Quản trị: <b>(024) 3999 8888</b> | Hỗ trợ: taisan@assethub.vn</span>
            <span>Xin chào, Nguyễn Duy An</span>
        </div>
    </div>

    <div class="header-main">
        <div class="container">
            <a href="/">
                <img src="~/images/logo.png" alt="AssetHub" />
            </a>
            <div class="cart-box">Quản lý tài sản</div>
        </div>
    </div>

    <nav class="navbar">
        <div class="container">
            <ul class="menu">
                <li class="active">
                    <a href="/">Nguyễn Duy An</a>
                </li>

                @if (ViewBag.LoaiTaiSan != null)
                {
                    foreach (var item in (IEnumerable<LoaiTaiSan>)ViewBag.LoaiTaiSan)
                    {
                        <li>
                            <a href="/Home/Filter/@item.MaLoai"
                               class="category-link"
                               data-id="@item.MaLoai">
                                @item.TenLoai
                            </a>
                        </li>
                    }
                }
            </ul>

            <form class="search-box">
                <input type="text" placeholder="Tìm tài sản..." />
                <button type="button">Tìm</button>
            </form>
        </div>
    </nav>
</header>
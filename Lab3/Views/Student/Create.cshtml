@model Lab2.Models.Student

@{
    ViewData["Title"] = "Create Student";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

<div class="container-fluid px-4 mt-3">
    <h2>Thêm sinh viên</h2>

    <div asp-validation-summary="All" class="text-danger"></div>

    <form action="/Admin/Student/Add" method="post" class="mt-3">

        <div class="form-group row mb-2">
            <label asp-for="Name" class="col-sm-2 col-form-label">Họ tên</label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Password" class="col-sm-2 col-form-label">Mật khẩu</label>
            <div class="col-sm-10">
                <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Branch" class="col-sm-2 col-form-label">Ngành học</label>
            <div class="col-sm-10">
                <select asp-for="Branch" class="form-select">
                    <option value="">-- Chọn ngành --</option>
                    <option value="IT">CNTT</option>
                    <option value="BE">Kinh tế</option>
                    <option value="CE">Công trình</option>
                    <option value="EE">Điện - Điện tử</option>
                </select>
                <span asp-validation-for="Branch" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label">Hệ đào tạo</label>
            <div class="col-sm-10">
                <input asp-for="IsRegular" type="checkbox" class="form-check-input" />
                <span>Chính quy</span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label">Ngày sinh</label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBorth" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Gender" class="col-sm-2 col-form-label">Giới tính</label>
            <div class="col-sm-10">
                @foreach (Lab2.Models.Gender gender in ViewBag.AllGenders)
                {
                    <label class="me-3">
                        <input type="radio" asp-for="Gender" value="@gender" />
                        @gender
                    </label>
                }
                <br />
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Address" class="col-sm-2 col-form-label">Địa chỉ</label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Mark" class="col-sm-2 col-form-label">Điểm</label>
            <div class="col-sm-10">
                <input asp-for="Mark" type="number" step="0.1" min="0" max="10" class="form-control" placeholder="Nhập điểm từ 0 đến 10" />
                <span asp-validation-for="Mark" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-3">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Thêm sinh viên</button>
                <a href="/Admin/Student/List" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>

    </form>
</div>

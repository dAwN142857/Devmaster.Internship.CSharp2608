@model IEnumerable<HangHoa>

<div class="content_top">
    <div class="heading">
        @* Tiêu đề được thay bằng họ tên sinh viên *@
        <h3>@ViewBag.TieuDe</h3>
    </div>
    <div class="see">
        <p><a href="@Url.Action("Index", "Home")">See all Products</a></p>
    </div>
    <div class="clear"></div>

    <div class="section group">
        @foreach (var item in Model)
        {
            <div class="grid_1_of_4 images_1_of_4">
                <img src="~/images/@item.Anh" alt="@item.TenHang" />
                <h2>@item.TenHang</h2>
                <div class="price-details">
                    <div class="price-number">
                        <p><span class="rupees">@item.Gia</span></p>
                    </div>
                    <div class="add-cart">
                        <h4><a href="#">Add to Cart</a></h4>
                    </div>
                    <div class="clear"></div>
                </div>
            </div>
        }
    </div>
</div>

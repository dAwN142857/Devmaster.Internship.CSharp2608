
@{
    ViewData["Title"] = "Thông tin sản phẩm";
}

<h1>@ViewData["Title"]</h1>
<hr/>
<div class="alert alert-danger">
    <h2>Lấy từ ViewBag</h2>
    <p>ID: @ViewBag.productVB.Id</p>
    <p>Name: @ViewBag.productVB.Name</p>
    <p>Quantity: @ViewBag.productVB.Price</p>
    <p>Price: @ViewBag.productVB.SalePrice</p>
</div>
<hr/>
@{
    var product = ViewData["productVD"] as TvcLesson03.Models.TvcProduct;
}
<div class="alert alert-info">
    <h2>Lấy từ ViewData</h2>
    <p>ID: @product.Id</p>
    <p>Name: @product.Name</p>
    <p>Quantity: @product.Price</p>
    <p>Price: @product.SalePrice</p>
</div>


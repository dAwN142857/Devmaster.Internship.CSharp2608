@model TvcLesson03.Models.TvcProduct

<h1>Chi tiết sản phẩm</h1>

<hr />

<div class="card" style="width: 500px;">
    <img src="~/images/@Model.Image"
         class="card-img-top"
         style="height:300px; object-fit:cover;" />

    <div class="card-body">
        <h2>@Model.Name</h2>

        <p>Mã sản phẩm: @Model.Id</p>

        <p>Giá: <del>@Model.Price</del></p>

        <p>Giá khuyến mãi: @Model.SalePrice</p>

        <p>Mô tả: @Model.Description</p>

        <p>
            Trạng thái:
            @(Model.Status ? "Còn hàng" : "Hết hàng")
        </p>

        <a href="/TvcProduct/GetAllProducts" class="btn btn-secondary">
            Quay lại
        </a>
    </div>
</div>
@model IEnumerable<TvcLesson09Layout.Areas.Admins.Models.Category>

@{
    ViewData["Title"] = "Category";
    Layout = "~/Areas/Admins/Views/Shared/_TvcLayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Quản lý danh mục</h3>
    <a asp-area="Admins"
       asp-controller="Category"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Thêm danh mục
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title">Danh sách danh mục</h5>
    </div>

    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>
                            <button type="button" class="btn btn-warning btn-sm">Sửa</button>
                            <form asp-area="Admins" asp-controller="Category"
                                  asp-action="Delete" asp-route-id="@item.Id"
                                  method="post" style="display:inline">
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

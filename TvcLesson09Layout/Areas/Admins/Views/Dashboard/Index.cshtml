
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admins/Views/Shared/_TvcLayoutAdmin.cshtml";
}


<div class="container-fluid">
    <h3 class="mb-3">Dashboard</h3>

    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="small-box text-bg-primary">
                <div class="inner">
                    <h3>150</h3>
                    <p>Tổng sản phẩm</p>
                </div>
                <div class="small-box-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box text-bg-success">
                <div class="inner">
                    <h3>20</h3>
                    <p>Danh mục</p>
                </div>
                <div class="small-box-icon">
                    <i class="bi bi-tags"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box text-bg-warning">
                <div class="inner">
                    <h3>8</h3>
                    <p>Banner</p>
                </div>
                <div class="small-box-icon">
                    <i class="bi bi-images"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box text-bg-danger">
                <div class="inner">
                    <h3>12</h3>
                    <p>Bài viết</p>
                </div>
                <div class="small-box-icon">
                    <i class="bi bi-journal-text"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <h5 class="card-title">Chào mừng đến trang quản trị</h5>
        </div>
        <div class="card-body">
            Chọn một chức năng ở menu bên trái để quản lý hệ thống.
        </div>
    </div>
</div>



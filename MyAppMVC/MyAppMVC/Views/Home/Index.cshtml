@{
    ViewData["Title"] = "Trang chủ";
}

<div class="p-5 mb-4 bg-primary text-white rounded-3 text-center">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">Microsoft Azure</h1>
        <p class="fs-4">Learn how Microsoft's Azure cloud platform allows you to build, deploy, and scale web apps.</p>
        <button class="btn btn-light btn-lg" type="button">Learn More</button>
    </div>
</div>

<div class="container my-4">
    <h3 class="mb-4">Danh sách sản phẩm</h3>
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @for (int i = 1; i <= 4; i++)
        {
            <div class="col">
                <div class="card h-100 text-center p-2">
                    <img src="~/images/product@(i).png" class="card-img-top rounded" alt="Product Name @i">
                    <div class="card-body">
                        <h5 class="card-title mt-2">Product Name @i</h5>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
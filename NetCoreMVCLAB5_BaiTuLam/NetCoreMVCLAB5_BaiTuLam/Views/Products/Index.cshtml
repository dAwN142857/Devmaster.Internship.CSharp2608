@model IEnumerable<Product>
@{ ViewData["Title"] = "Danh sách sản phẩm"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách sản phẩm</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm sản phẩm</a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th class="text-end">Giá</th>
            <th class="text-end">Giá khuyến mãi</th>
            <th style="width:210px">Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td><img class="thumb" src="~/products/@item.Image" alt="@item.Name" /></td>
            <td>@item.Name</td>
            <td>@item.Category?.Name</td>
            <td class="text-end">@Fmt.Vnd(item.Price)</td>
            <td class="text-end text-danger">@Fmt.Vnd(item.SalePrice)</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Chi tiết</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center">Chưa có sản phẩm nào. Hãy bấm "Thêm sản phẩm" để tạo mới.</p>
}

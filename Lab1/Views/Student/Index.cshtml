@model IEnumerable<Lab1.Models.Student>

<h2>List of Students</h2>

<a href="/Admin/Student/Add" class="btn btn-primary">Create Student</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBorth.ToString("d")</td>
                <td>
                    @{
                        string str = "";
                        switch (s.Branch)
                        {
                            case Lab1.Models.Branch.IT:
                                str = "CNTT";
                                break;
                            case Lab1.Models.Branch.BE:
                                str = "Kinh tế";
                                break;
                            case Lab1.Models.Branch.CE:
                                str = "Công trình";
                                break;
                            case Lab1.Models.Branch.EE:
                                str = "Điện - Điện tử";
                                break;
                        }
                    }
                    @str
                </td>
                <td>@(s.Gender == Lab1.Models.Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>

@model Lab1.Models.Student

<h2>Create Student</h2>

<div>
    <form action="/Admin/Student/Add" method="post" class="mt-3">
        <div class="form-group row mb-2">
            <label asp-for="Name" class="col-sm-2 col-form-label">Name</label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" />
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email" />
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Password" class="col-sm-2 col-form-label">Password</label>
            <div class="col-sm-10">
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Branch" class="col-sm-2 col-form-label">Branch</label>
            <div class="col-sm-10">
                <select asp-for="Branch" class="form-select">
                    <option value="">-- Chọn ngành --</option>
                    <option value="IT">CNTT</option>
                    <option value="BE">Kinh tế</option>
                    <option value="CE">Công trình</option>
                    <option value="EE">Điện - Điện tử</option>
                </select>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label">IsRegular</label>
            <div class="col-sm-10">
                <input asp-for="IsRegular" type="checkbox" class="form-check-input" />
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label">DateOfBorth</label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" type="date" class="form-control" />
            </div>
        </div>

        <div class="form-group row mb-2">
            <label class="col-sm-2 col-form-label">Gender</label>
            <div class="col-sm-10">
                @foreach (Lab1.Models.Gender gender in ViewBag.AllGenders)
                {
                    <label class="me-3">
                        <input type="radio" asp-for="Gender" value="@gender" />
                        @(gender == Lab1.Models.Gender.Male ? "Nam" : "Nữ")
                    </label>
                }
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Address" class="col-sm-2 col-form-label">Address</label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
            </div>
        </div>

        <div class="form-group row mt-3">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </div>
    </form>
</div>
